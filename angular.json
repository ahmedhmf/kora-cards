{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kora-card": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {"glob": "**/*", "input": "public"},
              {"glob": "**/*", "input": "node_modules/@mediapipe/tasks-vision/wasm", "output": "/mediapipe/wasm"}
            ],
            "styles": ["src/styles.css", "src/card-fixes.css", "src/brand-theme.css"],
            "outputPath": {"base": "dist", "browser": ""}
          }
        },
        "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "kora-card:build"}}
      }
    }
  }
}
